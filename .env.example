# ============================================================================
# Burger 24/7 - Variables de Entorno (Plantilla Principal de Ejemplo)
# Copie este archivo como '.env' en la raíz de su proyecto o virtual host de Apache:
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux/macOS:        cp .env.example .env
# NUNCA suba el archivo '.env' real al control de versiones (Git).
# ============================================================================

# 1. Base de Datos MySQL / MariaDB (XAMPP / Producción)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=burger_shop
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# 2. Clave Secreta para Firma y Verificación de Tokens JWT (HMAC-SHA256)
# IMPORTANTE: Reemplace este valor en producción por una cadena aleatoria
# criptográficamente segura de mínimo 32 caracteres (ej: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here_change_in_production

# 3. Política de CORS Estricta (Orígenes HTTP/HTTPS permitidos separados por coma)
# Configure aquí la URL o dominio exacto desde donde accederá el navegador:
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
