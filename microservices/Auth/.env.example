# ============================================================================
# Configuración de Entorno (Plantilla de Ejemplo)
# Copie este archivo como '.env' y configure sus credenciales locales.
# NUNCA suba el archivo '.env' al control de versiones.
# ============================================================================

# Base de Datos MySQL
DB_HOST=127.0.0.1
DB_NAME=bebidas_247
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Clave Secreta para Tokens JWT (Debe ser rotada periódicamente, mínimo 32 caracteres)
JWT_SECRET=your_jwt_secret_here_change_in_production

# Configuración de CORS (Orígenes permitidos separados por comas)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://localhost
