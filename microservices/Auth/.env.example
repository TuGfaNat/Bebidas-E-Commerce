# ============================================================================
# Burger 24/7 - Variables de Entorno (Plantilla de Ejemplo)
# Copie este archivo como '.env' en la raíz o en microservices/Auth/
# NUNCA suba el archivo '.env' real al control de versiones (Git).
# ============================================================================

# Base de Datos MySQL (XAMPP / Producción)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=burger_shop
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Clave Secreta para Firma de Tokens JWT (Mínimo 32 caracteres seguros)
# IMPORTANTE: Cambie esta clave en producción; no use valores por defecto
JWT_SECRET=your_jwt_secret_here_change_in_production

# Configuración de CORS Estricta (Orígenes permitidos separados por comas)
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
